  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "lint": "prettier --check . && lunte forge.config.js electron lib renderer test workers",
    "format": "prettier --write . && lunte --fix",
    "start": "electron-forge start -- --no-updates",
    "package": "electron-forge package && node test/packaged-worker-smoke.js",
    "make": "electron-forge make",
    "install:all": "npm i --ignore-scripts=true && npm run install:electron",
    "install:electron": "node node_modules/electron/install.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --test-timeout=15000 test/*.test.js",
    "test:integration": "node --test --test-timeout=35000 test/integration/*.test.js"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-fs": "^4.8.0",
    "bare-path": "^3.1.1",
    "corestore": "^7.12.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.0",
    "pear-runtime": "^1.3.1",
    "which-runtime": "^1.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "app-builder-lib": "^26.8.1",
    "electron": "^42.11.16",
    "electron-forge-plugin-prune-prebuilds": "^1.0.0",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "hyperdht": "^6.33.0",
    "lunte": "^1.6.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "pear-electron-forge-maker-flatpak": "^0.0.6",
    "pear-electron-forge-maker-snap": "^1.0.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0"
  },
  "allowScripts": {
    "electron@40.10.1": true,
    "electron-winstaller": false
  }
